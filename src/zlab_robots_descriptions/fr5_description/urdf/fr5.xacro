<?xml version="1.0"?>
<robot name="fr5" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Layout configuration file -->
    <xacro:arg name="layout_config" default=""/>
    <xacro:property name="layout_config_file" value="$(arg layout_config)"/>
    <xacro:property name="layout" value="${xacro.load_yaml(layout_config_file) if layout_config_file else dict()}"/>

    <!-- 定义参数 -->
    <!-- arm_id: 机械臂ID，可以是 arm1, arm2 等，默认为 arm1 -->
    <xacro:arg name="arm_id" default="arm1" />
    <!-- 定义工具参数 -->
    <xacro:arg name="tool_name" default="none"/>

    <!-- Position Arguments -->
    <xacro:arg name="xyz" default="0 0 0"/>
    <xacro:arg name="rpy" default="0 0 0"/>

    <!-- 加载工具库 -->
    <xacro:include filename="$(find zlab_tools_description)/urdf/zlab_tools.xacro" />

    <!-- 加载机械臂库 -->
    <xacro:include filename="$(find fr5_description)/urdf/fr5_library.xacro" />

    <!-- 添加虚拟根链接 -->
    <link name="world" />

    <!-- Resolve position with priority: 1. CLI/Launch > 2. Layout YAML > 3. Default -->
    <xacro:property name="arm_id_str" value="$(arg arm_id)"/>
    <xacro:property name="xyz_arg" value="$(arg xyz)"/>
    <xacro:property name="rpy_arg" value="$(arg rpy)"/>
    
    <xacro:property name="xyz_final" value="${xyz_arg if xyz_arg != '0 0 0' else (layout[arm_id_str]['xyz'] if arm_id_str in layout and 'xyz' in layout[arm_id_str] else '0 0 0')}"/>
    <xacro:property name="rpy_final" value="${rpy_arg if rpy_arg != '0 0 0' else (layout[arm_id_str]['rpy'] if arm_id_str in layout and 'rpy' in layout[arm_id_str] else '0 0 0')}"/>

    <!-- 实例化机械臂 -->
    <xacro:fr5 
        arm_id="$(arg arm_id)" 
        connected_to="world" 
        xyz="${xyz_final}" 
        rpy="${rpy_final}"
        tool_name="$(arg tool_name)" />

    <xacro:gazebo-joint joint="$(arg arm_id)_joint_1" />
    <xacro:gazebo-joint joint="$(arg arm_id)_joint_2" />
    <xacro:gazebo-joint joint="$(arg arm_id)_joint_3" />
    <xacro:gazebo-joint joint="$(arg arm_id)_joint_4" />
    <xacro:gazebo-joint joint="$(arg arm_id)_joint_5" />
    <xacro:gazebo-joint joint="$(arg arm_id)_joint_6" />

    <!-- load ros_control plugin -->
    <gazebo>
        <plugin name="gazebo_ros_control" filename="libgazebo_ros_control.so" />
    </gazebo>


</robot>

