<?xml version="1.0"?>
<robot name="zlab_triple_arms" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Layout configuration file -->
    <xacro:arg name="layout_config" default=""/>
    <xacro:property name="layout_config_file" value="$(arg layout_config)"/>
    <xacro:property name="layout" value="${xacro.load_yaml(layout_config_file) if layout_config_file else dict()}"/>

    <!-- Arguments for positions -->
    <!-- Diana7 (Center) -->
    <xacro:arg name="diana7_xyz" default=""/>
    <xacro:arg name="diana7_rpy" default=""/>

    <!-- FR5 Arm 1 (Left) -->
    <xacro:arg name="arm1_xyz" default=""/>
    <xacro:arg name="arm1_rpy" default=""/>

    <!-- FR5 Arm 2 (Right) -->
    <xacro:arg name="arm2_xyz" default=""/>
    <xacro:arg name="arm2_rpy" default=""/>

    <!-- Resolve positions (Priority: CLI/Launch > YAML > Xacro Default) -->
    <xacro:property name="d7_xyz_arg" value="$(arg diana7_xyz)"/>
    <xacro:property name="d7_rpy_arg" value="$(arg diana7_rpy)"/>
    <xacro:property name="diana7_xyz_final" value="${d7_xyz_arg if d7_xyz_arg != '' else (layout['diana7']['xyz'] if 'diana7' in layout and 'xyz' in layout['diana7'] else '0 0 0')}"/>
    <xacro:property name="diana7_rpy_final" value="${d7_rpy_arg if d7_rpy_arg != '' else (layout['diana7']['rpy'] if 'diana7' in layout and 'rpy' in layout['diana7'] else '0 0 0')}"/>

    <xacro:property name="a1_xyz_arg" value="$(arg arm1_xyz)"/>
    <xacro:property name="a1_rpy_arg" value="$(arg arm1_rpy)"/>
    <xacro:property name="arm1_xyz_final" value="${a1_xyz_arg if a1_xyz_arg != '' else (layout['arm1']['xyz'] if 'arm1' in layout and 'xyz' in layout['arm1'] else '1.5 -0.2 0')}"/>
    <xacro:property name="arm1_rpy_final" value="${a1_rpy_arg if a1_rpy_arg != '' else (layout['arm1']['rpy'] if 'arm1' in layout and 'rpy' in layout['arm1'] else '0 0 0')}"/>

    <xacro:property name="a2_xyz_arg" value="$(arg arm2_xyz)"/>
    <xacro:property name="a2_rpy_arg" value="$(arg arm2_rpy)"/>
    <xacro:property name="arm2_xyz_final" value="${a2_xyz_arg if a2_xyz_arg != '' else (layout['arm2']['xyz'] if 'arm2' in layout and 'xyz' in layout['arm2'] else '1.5 0.4 0')}"/>
    <xacro:property name="arm2_rpy_final" value="${a2_rpy_arg if a2_rpy_arg != '' else (layout['arm2']['rpy'] if 'arm2' in layout and 'rpy' in layout['arm2'] else '0 0 0')}"/>

    <!-- Arguments for tools -->
    <xacro:arg name="arm1_tool" default="none"/>
    <xacro:arg name="arm2_tool" default="none"/>
    <xacro:arg name="diana7_tool" default="none"/>

    <!-- Include Macros -->
    <xacro:include filename="$(find fr5_description)/urdf/fr5_library.xacro" />
    <xacro:include filename="$(find diana7_description)/urdf/diana7_macro.xacro" />
    <xacro:include filename="$(find zlab_tools_description)/urdf/zlab_tools.xacro" />

    <!-- World Link -->
    <link name="world" />

    <!-- Instantiate Diana7 -->
    <xacro:diana7_robot 
        prefix="diana7_" 
        parent="world"
        tool_name="$(arg diana7_tool)">
        <origin xyz="${diana7_xyz_final}" rpy="${diana7_rpy_final}"/>
    </xacro:diana7_robot>

    <!-- Instantiate FR5 Arm 1 -->
    <xacro:fr5 
        arm_id="arm1" 
        connected_to="world" 
        xyz="${arm1_xyz_final}" 
        rpy="${arm1_rpy_final}" 
        tool_name="$(arg arm1_tool)"/>
    
    <!-- Instantiate FR5 Arm 2 -->
    <xacro:fr5 
        arm_id="arm2" 
        connected_to="world" 
        xyz="${arm2_xyz_final}" 
        rpy="${arm2_rpy_final}" 
        tool_name="$(arg arm2_tool)"/>

    <!-- Gazebo Transmissions for FR5 arms -->
    <xacro:gazebo-joint joint="arm1_joint_1" />
    <xacro:gazebo-joint joint="arm1_joint_2" />
    <xacro:gazebo-joint joint="arm1_joint_3" />
    <xacro:gazebo-joint joint="arm1_joint_4" />
    <xacro:gazebo-joint joint="arm1_joint_5" />
    <xacro:gazebo-joint joint="arm1_joint_6" />

    <xacro:gazebo-joint joint="arm2_joint_1" />
    <xacro:gazebo-joint joint="arm2_joint_2" />
    <xacro:gazebo-joint joint="arm2_joint_3" />
    <xacro:gazebo-joint joint="arm2_joint_4" />
    <xacro:gazebo-joint joint="arm2_joint_5" />
    <xacro:gazebo-joint joint="arm2_joint_6" />

    <!-- load ros_control plugin -->
    <gazebo>
        <plugin name="gazebo_ros_control" filename="libgazebo_ros_control.so" />
    </gazebo>

</robot>