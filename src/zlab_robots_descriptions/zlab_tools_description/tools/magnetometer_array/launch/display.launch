<launch>
  <arg
    name="model" />
  <param
    name="robot_description"
    command="$(find xacro)/xacro $(find zlab_tools_description)/tools/magnetometer_array/urdf/magnetometer_array.urdf.xacro" />
  <node
    name="joint_state_publisher_gui"
    pkg="joint_state_publisher_gui"
    type="joint_state_publisher_gui" />
  <node
    name="robot_state_publisher"
    pkg="robot_state_publisher"
    type="robot_state_publisher" />
  <node
    name="rviz"
    pkg="rviz"
    type="rviz"
    args="-d $(find zlab_tools_description)/tools/magnetometer_array/urdf.rviz" />
</launch>