<?xml version="1.0"?>
<robot name="zlab_dual_arms" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- 定义参数 -->
    <!-- arm1 工具参数 -->
    <xacro:arg name="arm1_tool" default="none"/>
    <!-- arm2 工具参数 -->
    <xacro:arg name="arm2_tool" default="none"/>
    <!-- arm1 位置参数（默认在原点） -->
    <xacro:arg name="arm1_xyz" default="0 0 0"/>
    <xacro:arg name="arm1_rpy" default="0 0 0"/>
    <!-- arm2 位置参数（如果未指定，将根据标定文件或默认值计算） -->
    <xacro:arg name="arm2_xyz" default=""/>
    <xacro:arg name="arm2_rpy" default=""/>

    <!-- 加载机械臂库 -->
    <xacro:include filename="$(find fr5_description)/fr/urdf/fr5_library.xacro" />

    <!-- 创建世界坐标系 -->
    <link name="world" />

    <!-- ========== 加载 arm1 工具配置 ========== -->
    <xacro:property name="arm1_tool_name_arg" value="$(arg arm1_tool)"/>
    <xacro:property name="arm1_tool_config" value="{}"/>
    
    <xacro:unless value="${arm1_tool_name_arg == 'none'}">
        <xacro:property name="arm1_tool_package_path" 
                        value="$(find fr5_description)/tools/${arm1_tool_name_arg}/config/tool.yaml"/>
        <xacro:property name="arm1_tool_config" 
                        value="${xacro.load_yaml(arm1_tool_package_path)}"/>
    </xacro:unless>

    <!-- ========== 加载 arm2 工具配置 ========== -->
    <xacro:property name="arm2_tool_name_arg" value="$(arg arm2_tool)"/>
    <xacro:property name="arm2_tool_config" value="{}"/>
    
    <xacro:unless value="${arm2_tool_name_arg == 'none'}">
        <xacro:property name="arm2_tool_package_path" 
                        value="$(find fr5_description)/tools/${arm2_tool_name_arg}/config/tool.yaml"/>
        <xacro:property name="arm2_tool_config" 
                        value="${xacro.load_yaml(arm2_tool_package_path)}"/>
    </xacro:unless>

    <!-- ========== 设置arm2位置 ========== -->
    <!-- 默认值：arm1在原点，arm2在右边1米处 -->
    <xacro:property name="arm2_xyz_default" value="1.0 0.0 0.0"/>
    <xacro:property name="arm2_rpy_default" value="0.0 0.0 0.0"/>

    <!-- 获取arm2位置参数值 -->
    <xacro:property name="arm2_xyz_arg" value="$(arg arm2_xyz)"/>
    <xacro:property name="arm2_rpy_arg" value="$(arg arm2_rpy)"/>

    <!-- 如果arm2_xyz参数未指定（为空），尝试从标定文件加载 -->
    <xacro:if value="${arm2_xyz_arg == ''}">
        <xacro:property name="calibration_file_path"
                        value="$(find fr5_description)/config/dual_arm_calibration.yaml"/>
        <xacro:property name="calibration_config"
                        value="${xacro.load_yaml(calibration_file_path)}"/>
        <xacro:property name="transform" value="${calibration_config['arm1_to_arm2_transform']}"/>
        <xacro:property name="translation" value="${transform['translation']}"/>
        <xacro:property name="rpy" value="${transform['rpy']}"/>

        <!-- 使用标定文件中的位置和姿态 -->
        <xacro:property name="arm2_xyz_final"
                        value="${translation['x']} ${translation['y']} ${translation['z']}"/>
        <xacro:property name="arm2_rpy_final"
                        value="${rpy['roll']} ${rpy['pitch']} ${rpy['yaw']}"/>
    </xacro:if>

    <!-- 如果arm2_xyz参数已指定，使用参数值 -->
    <xacro:unless value="${arm2_xyz_arg == ''}">
        <xacro:property name="arm2_xyz_final" value="${arm2_xyz_arg}"/>
        <xacro:if value="${arm2_rpy_arg == ''}">
            <xacro:property name="arm2_rpy_final" value="${arm2_rpy_default}"/>
        </xacro:if>
        <xacro:unless value="${arm2_rpy_arg == ''}">
            <xacro:property name="arm2_rpy_final" value="${arm2_rpy_arg}"/>
        </xacro:unless>
    </xacro:unless>

    <!-- ========== 实例化 arm1 ========== -->
    <xacro:fr 
        arm_id="arm1" 
        connected_to="world" 
        xyz="$(arg arm1_xyz)"
        rpy="$(arg arm1_rpy)"
        tool_name="$(arg arm1_tool)"
        tool_config="${arm1_tool_config}" />

    <xacro:gazebo-joint joint="arm1_j1" />
    <xacro:gazebo-joint joint="arm1_j2" />
    <xacro:gazebo-joint joint="arm1_j3" />
    <xacro:gazebo-joint joint="arm1_j4" />
    <xacro:gazebo-joint joint="arm1_j5" />
    <xacro:gazebo-joint joint="arm1_j6" />

    <!-- ========== 实例化 arm2 ========== -->
    <xacro:fr 
        arm_id="arm2" 
        connected_to="world" 
        xyz="${arm2_xyz_final}"
        rpy="${arm2_rpy_final}"
        tool_name="$(arg arm2_tool)"
        tool_config="${arm2_tool_config}" />

    <xacro:gazebo-joint joint="arm2_j1" />
    <xacro:gazebo-joint joint="arm2_j2" />
    <xacro:gazebo-joint joint="arm2_j3" />
    <xacro:gazebo-joint joint="arm2_j4" />
    <xacro:gazebo-joint joint="arm2_j5" />
    <xacro:gazebo-joint joint="arm2_j6" />

    <!-- load ros_control plugin -->
    <gazebo>
        <plugin name="gazebo_ros_control" filename="libgazebo_ros_control.so" />
    </gazebo>

</robot>

