<launch>
  <!-- 可调参数：数据来源话题与等待超时时间（秒） -->
  <arg name="magnetic_field_topic" default="/magnetic_field/processed" />
  <arg name="wait_timeout" default="2.0" />

  <node pkg="task_magnetic_field" type="mag_data_collector_node" name="mag_data_collector_node" output="screen">
    <param name="magnetic_field_topic" value="$(arg magnetic_field_topic)" />
    <param name="wait_timeout" value="$(arg wait_timeout)" />
  </node>
</launch>
