<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="magnetometer_array" params="prefix parent">
    
    <joint name="${prefix}tool_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${prefix}magnetometer_base_link"/>
      <origin xyz="0 0 0" rpy="0 0 ${pi/2}"/>
    </joint>

    <link name="${prefix}magnetometer_base_link">
      <inertial>
        <origin xyz="2.0717E-07 0.0021605 -0.036248" rpy="0 0 0" />
        <mass value="0.033205" />
        <inertia ixx="5.6306E-05" ixy="-5.922E-12" ixz="6.6801E-10" iyy="5.9694E-05" iyz="2.0305E-06" izz="1.1454E-05" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://zlab_tools_description/magnetometer_array/meshes/magnetometer_base_link.STL" />
        </geometry>
        <material name="">
          <color rgba="1 1 1 1" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://zlab_tools_description/magnetometer_array/meshes/magnetometer_base_link.STL" />
        </geometry>
      </collision>
    </link>

    <link name="${prefix}magnetometer_tcp_link">
      <inertial>
        <origin xyz="-0.00019067 0.0018908 -0.060443" rpy="0 0 0" />
        <mass value="0.0022623" />
        <inertia ixx="3.3502E-07" ixy="6.2726E-20" ixz="-6.8291E-10" iyy="4.1094E-07" iyz="1.8218E-19" izz="8.7172E-08" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://zlab_tools_description/magnetometer_array/meshes/magnetometer_tcp_link.STL" />
        </geometry>
        <material name="">
          <color rgba="0.75294 0.75294 0.75294 1" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://zlab_tools_description/magnetometer_array/meshes/magnetometer_tcp_link.STL" />
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}magnetometer_joint" type="fixed">
      <origin xyz="0 0.00023753 -0.19309" rpy="3.1416 0 3.1416" />
      <parent link="${prefix}magnetometer_base_link" />
      <child link="${prefix}magnetometer_tcp_link" />
      <axis xyz="0 0 0" />
    </joint>

  </xacro:macro>
</robot>
