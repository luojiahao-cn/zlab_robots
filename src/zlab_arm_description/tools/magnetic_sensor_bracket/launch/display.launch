<launch>
  <arg
    name="model" />
  <param
    name="robot_description"
    textfile="$(find zlab_arm_description)/tools/magnetic_sensor_bracket/urdf/bracket.urdf" />
  <node
    name="joint_state_publisher_gui"
    pkg="joint_state_publisher_gui"
    type="joint_state_publisher_gui" />
  <node
    name="robot_state_publisher"
    pkg="robot_state_publisher"
    type="robot_state_publisher" />
  <node
    name="rviz"
    pkg="rviz"
    type="rviz"
    args="-d $(find zlab_arm_description)/tools/magnetic_sensor_bracket/urdf.rviz" />
</launch>