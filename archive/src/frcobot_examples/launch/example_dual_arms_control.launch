<launch>
  <!-- 启动 ROS master -->
  <arg name="use_sim_time" default="false"/>
  <param name="/use_sim_time" value="$(arg use_sim_time)"/>

  <!-- 启动双机械臂控制节点 -->
  <node name="example_dual_arms_control" pkg="frcobot_examples" type="example_dual_arms_control"
        output="screen">

  </node>
</launch>