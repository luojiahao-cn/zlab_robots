<launch>

    <arg name="config" default="$(find moveit_servo)/config/single_config.yaml" />

    <node name="servo_server" pkg="moveit_servo" type="servo_server" output="screen">
        <rosparam command="load" file="$(arg config)" />
        <param name="control_mode" value="velocity" />
    </node>

    <rosparam
        file="$(find ros_control_boilerplate)/frrobot_control/config/frrobot_controllers.yaml"
        command="load" />

    <node name="controller_stopper" pkg="controller_manager" type="controller_manager"
        output="screen"
        args="stop fr5v6_arm_controller" />
        
    <node name="controller_spawner" pkg="controller_manager" type="spawner" output="screen"
        args="joints_position_controller" />

</launch>