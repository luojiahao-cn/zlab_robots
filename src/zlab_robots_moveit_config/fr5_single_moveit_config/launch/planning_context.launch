<launch>
  <!-- By default we do not overwrite the URDF. Change the following to true to change the default behavior -->
  <arg name="load_robot_description" default="false"/>

  <!-- The name of the parameter under which the URDF is loaded -->
  <arg name="robot_description" default="robot_description"/>

  <!-- Arm ID parameter -->
  <arg name="arm_id" default="arm1" doc="Arm ID to use"/>

  <!-- Tool parameter (optional, defaults to none) -->
  <arg name="tool_name" default="none" doc="Tool name to use"/>

  <!-- Load universal robot description format (URDF) -->
  <param if="$(arg load_robot_description)" name="$(arg robot_description)"
         command="$(find xacro)/xacro '$(find fr5_description)/urdf/fr5.xacro'
                 arm_id:=$(arg arm_id) tool_name:=$(arg tool_name)"/>

  <!-- The semantic description that corresponds to the URDF -->
  <!-- Use xacro to process SRDF file with arm_id parameter -->
  <param name="$(arg robot_description)_semantic"
         command="$(find xacro)/xacro '$(find fr5_single_moveit_config)/config/fr5.srdf.xacro'
                 arm_id:=$(arg arm_id) tool_name:=$(arg tool_name)" />

  <!-- Load updated joint limits (override information from URDF) -->
  <group ns="$(arg robot_description)_planning">
    <!-- Load joint limits from YAML file with parameter substitution -->
    <rosparam command="load" file="$(find fr5_single_moveit_config)/config/joint_limits.yaml" subst_value="true"/>

    <rosparam command="load" file="$(find fr5_single_moveit_config)/config/cartesian_limits.yaml"/>
  </group>

  <!-- Load default settings for kinematics; these settings are overridden by settings in a node's namespace -->
  <group ns="$(arg robot_description)_kinematics">
    <rosparam command="load" file="$(find fr5_single_moveit_config)/config/kinematics.yaml"/>

  </group>

</launch>
