<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="diana7">
  
  <!-- Layout configuration file -->
  <xacro:arg name="layout_config" default=""/>
  <xacro:property name="layout_config_file" value="$(arg layout_config)"/>
  <xacro:property name="layout" value="${xacro.load_yaml(layout_config_file) if layout_config_file else dict()}"/>

  <!-- Position Arguments -->
  <xacro:arg name="xyz" default="0 0 0"/>
  <xacro:arg name="rpy" default="0 0 0"/>

  <!-- Tool Argument -->
  <xacro:arg name="tool_name" default="none"/>

  <!-- Include Diana7 Macro -->
  <xacro:include filename="$(find diana7_description)/urdf/diana7_macro.xacro" />

  <link name="world" />

  <!-- Resolve position with priority: 1. CLI/Launch > 2. Layout YAML > 3. Default -->
  <xacro:property name="xyz_arg" value="$(arg xyz)"/>
  <xacro:property name="rpy_arg" value="$(arg rpy)"/>
  
  <xacro:property name="xyz_final" value="${xyz_arg if xyz_arg != '0 0 0' else (layout['diana7']['xyz'] if 'diana7' in layout and 'xyz' in layout['diana7'] else '0 0 0')}"/>
  <xacro:property name="rpy_final" value="${rpy_arg if rpy_arg != '0 0 0' else (layout['diana7']['rpy'] if 'diana7' in layout and 'rpy' in layout['diana7'] else '0 0 0')}"/>

  <!-- Instantiate Diana7 -->
  <xacro:diana7_robot 
    prefix="diana7_" 
    parent="world" 
    tool_name="$(arg tool_name)">
    <origin xyz="${xyz_final}" rpy="${rpy_final}" />
  </xacro:diana7_robot>

</robot>
