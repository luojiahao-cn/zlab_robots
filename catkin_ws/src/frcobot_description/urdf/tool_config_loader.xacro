<?xml version="1.0" encoding="utf-8"?>
<!--
    工具配置加载器
    优先从工具包加载配置，如果不存在则从旧的tools.yaml加载
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!--
        加载工具配置
        参数:
        - tool_name: 工具名称
        返回: tool_config字典
    -->
    <xacro:macro name="load_tool_config" params="tool_name">
        <xacro:property name="tool_config_result" value="${None}"/>
        
        <!-- 首先尝试从工具包加载 -->
        <xacro:property name="tool_package_config_path" 
                        value="$(find frcobot_tools)/tools/${tool_name}/config/tool.yaml"/>
        
        <!-- 检查工具包配置文件是否存在 -->
        <!-- 注意：xacro无法直接检查文件是否存在，所以我们先尝试加载 -->
        <!-- 如果失败，会在下面的unless分支中处理 -->
        
        <xacro:try>
            <xacro:property name="tool_package_config" 
                            value="${xacro.load_yaml(tool_package_config_path)}"/>
            <xacro:property name="tool_config_result" value="${tool_package_config}"/>
            <xacro:property name="config_source" value="package"/>
        </xacro:try>
        <xacro:catch>
            <!-- 如果工具包不存在，尝试从旧的tools.yaml加载 -->
            <xacro:property name="old_tools_config_path" 
                            value="$(find frcobot_description)/config/tools.yaml"/>
            <xacro:property name="old_tools_config" 
                            value="${xacro.load_yaml(old_tools_config_path)}"/>
            <xacro:property name="tool_config_result" 
                            value="${old_tools_config['tools'][tool_name]}"/>
            <xacro:property name="config_source" value="legacy"/>
        </xacro:catch>
        
        <!-- 如果工具名称为none，返回空配置 -->
        <xacro:if value="${tool_name == 'none'}">
            <xacro:property name="tool_config_result" value="{
                'tool_type': 'simple',
                'origin': {'xyz': [0,0,0], 'rpy': [0,0,0]},
                'tcp': {'xyz': [0,0,0], 'rpy': [0,0,0]},
                'physical_properties': {'mass': 0.1, 'inertia': {'ixx': 0.1, 'ixy': 0.0, 'ixz': 0.0, 'iyy': 0.1, 'iyz': 0.0, 'izz': 0.1}}
            }"/>
        </xacro:if>
        
    </xacro:macro>

</robot>

