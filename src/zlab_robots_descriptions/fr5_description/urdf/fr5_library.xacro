<?xml version="1.0" encoding="utf-8"?>
<robot name="fr5" xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="fr5"
        params="arm_id:='fr1' connected_to:='' xyz:='0 0 0' rpy:='0 0 0' tool_name:='none'">
        <xacro:unless value="${not connected_to}">
            <joint name="${arm_id}_joint_world_to_pedestal" type="fixed">
                <parent link="${connected_to}" />
                <child link="${arm_id}_pedestal_link" />
                <origin rpy="${rpy}" xyz="${xyz}" />
            </joint>
        </xacro:unless>

        <!-- 定义一些常用的属性 -->
        <xacro:property name="color" value="0.89804 0.91765 0.92941 1" />
        <xacro:property name="material_name" value="" />

        <!-- Pedestal Link: Merged base0 and base1 -->
        <link name="${arm_id}_pedestal_link">
            <inertial>
                <origin xyz="0.00022281 -3.2078E-06 0.11314" rpy="0 0 0" />
                <mass value="53.2172" /> <!-- base0 (50.058) + base1 (3.1592) -->
                <inertia ixx="0.88248" ixy="-2.9247E-05" ixz="9.7148E-05" iyy="0.88247" iyz="-1.6883E-06" izz="1.54807" />
            </inertial>
            <!-- base0 visual -->
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <mesh filename="package://fr5_description/meshes/visual/extra_base_link.DAE" />
                </geometry>
                <material name="${material_name}"><color rgba="${color}" /></material>
            </visual>
            <!-- base1 visual -->
            <visual>
                <origin xyz="0 0 0.487" rpy="0 0 0" />
                <geometry>
                    <mesh filename="package://fr5_description/meshes/visual/plant_link.DAE" />
                </geometry>
                <material name="${material_name}"><color rgba="${color}" /></material>
            </visual>
            <!-- base0 collision -->
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <mesh filename="package://fr5_description/meshes/collision/extra_base_link.STL" />
                </geometry>
            </collision>
            <!-- base1 collision -->
            <collision>
                <origin xyz="0 0 0.487" rpy="0 0 0" />
                <geometry>
                    <mesh filename="package://fr5_description/meshes/collision/plant_link.STL" />
                </geometry>
            </collision>
        </link>

        <!-- Base Link: Robot base (formerly base2) -->
        <xacro:macro name="link_with_inertial"
            params="name xyz rpy mass ixx ixy ixz iyy iyz izz visual_mesh collision_mesh scale:='1 1 1'">
            <link name="${name}">
                <inertial>
                    <origin xyz="${xyz}" rpy="${rpy}" />
                    <mass value="${mass}" />
                    <inertia ixx="${ixx}" ixy="${ixy}" ixz="${ixz}" iyy="${iyy}" iyz="${iyz}"
                        izz="${izz}" />
                </inertial>
                <visual>
                    <origin xyz="0 0 0" rpy="0 0 0" />
                    <geometry>
                        <mesh filename="${visual_mesh}" scale="${scale}" />
                    </geometry>
                    <material name="${material_name}">
                        <color rgba="${color}" />
                    </material>
                </visual>
                <collision>
                    <origin xyz="0 0 0" rpy="0 0 0" />
                    <geometry>
                        <mesh filename="${collision_mesh}" scale="${scale}" />
                    </geometry>
                </collision>
            </link>
        </xacro:macro>

        <xacro:link_with_inertial name="${arm_id}_base_link" xyz="-0.00031896 -0.00029673 0.042463"
            rpy="0 0 0"
            mass="1.6185"
            ixx="0.0030836" ixy="1.5354E-05" ixz="-1.9315E-05" iyy="0.0030825" iyz="-1.7918E-05"
            izz="0.0045209"
            visual_mesh="package://fr5_description/meshes/visual/base_link.DAE"
            collision_mesh="package://fr5_description/meshes/collision/base_link.STL" />

        <joint name="${arm_id}_joint_pedestal_to_base" type="fixed">
            <parent link="${arm_id}_pedestal_link" />
            <child link="${arm_id}_base_link" />
            <origin xyz="0 0 0.4871" rpy="0 0 0" />
        </joint>

        <xacro:link_with_inertial name="${arm_id}_link_1" xyz="5.0029E-07 -0.0040922 0.14629"
            rpy="0 0 0"
            mass="4.3771"
            ixx="0.010731" ixy="-8.0587E-09" ixz="-3.6773E-08" iyy="0.010408" iyz="0.00012853"
            izz="0.0081793"
            visual_mesh="package://fr5_description/meshes/visual/link_1.DAE"
            collision_mesh="package://fr5_description/meshes/collision/link_1.STL" />

        <joint name="${arm_id}_joint_1" type="revolute">
            <origin xyz="0 0 0" rpy="0 0 0" />
            <parent link="${arm_id}_base_link" />
            <child link="${arm_id}_link_1" />
            <axis xyz="0 0 1" />
            <limit lower="-3.0543" upper="3.0543" effort="150" velocity="3.15" />
            <calibration rising="0" falling="0" />
            <dynamics damping="0" friction="0" />
            <safety_controller soft_lower_limit="-3.0543" soft_upper_limit="3.0543" k_position="15"
                k_velocity="10" />
        </joint>

        <xacro:link_with_inertial name="${arm_id}_link_2" xyz="-0.2125 -5.7643E-09 0.1346"
            rpy="0 0 0"
            mass="14.458"
            ixx="0.028392" ixy="-1.337E-07" ixz="-3.9895E-09" iyy="0.4559" iyz="4.214E-08"
            izz="0.44974"
            visual_mesh="package://fr5_description/meshes/visual/link_2.DAE"
            collision_mesh="package://fr5_description/meshes/collision/link_2.STL" />

        <joint name="${arm_id}_joint_2" type="revolute">
            <origin xyz="0 0 0.152" rpy="1.5708 0 0" />
            <parent link="${arm_id}_link_1" />
            <child link="${arm_id}_link_2" />
            <axis xyz="0 0 1" />
            <limit lower="-4.6251" upper="1.4835" effort="150" velocity="3.15" />
            <calibration rising="0" falling="0" />
            <dynamics damping="0" friction="0" />
            <safety_controller soft_lower_limit="-4.6251" soft_upper_limit="1.4835" k_position="15"
                k_velocity="10" />
        </joint>

        <xacro:link_with_inertial name="${arm_id}_link_3" xyz="-0.18793 -8.4503E-07 0.0066357"
            rpy="0 0 0"
            mass="7.6737"
            ixx="0.0085096" ixy="2.1613E-06" ixz="-0.0068678" iyy="0.16971" iyz="3.7086E-08"
            izz="0.16854"
            visual_mesh="package://fr5_description/meshes/visual/link_3.DAE"
            collision_mesh="package://fr5_description/meshes/collision/link_3.STL" />

        <joint name="${arm_id}_joint_3" type="revolute">
            <origin xyz="-0.425 0 0" rpy="0 0 0" />
            <parent link="${arm_id}_link_2" />
            <child link="${arm_id}_link_3" />
            <axis xyz="0 0 1" />
            <limit lower="-2.8274" upper="2.8274" effort="150" velocity="3.15" />
            <calibration rising="0" falling="0" />
            <dynamics damping="0" friction="0" />
            <safety_controller soft_lower_limit="-2.8274" soft_upper_limit="2.8274" k_position="15"
                k_velocity="10" />
        </joint>

        <xacro:link_with_inertial name="${arm_id}_link_4" xyz="4.98E-07 -0.003754 0.097155"
            rpy="0 0 0"
            mass="1.6266"
            ixx="0.00216" ixy="4.888E-09" ixz="3.1528E-08" iyy="0.0015455" iyz="3.7678E-05"
            izz="0.0019902"
            visual_mesh="package://fr5_description/meshes/visual/link_4.DAE"
            collision_mesh="package://fr5_description/meshes/collision/link_4.STL" />

        <joint name="${arm_id}_joint_4" type="revolute">
            <origin xyz="-0.39501 0 0" rpy="0 0 0" />
            <parent link="${arm_id}_link_3" />
            <child link="${arm_id}_link_4" />
            <axis xyz="0 0 1" />
            <limit lower="-4.6251" upper="1.4835" effort="28" velocity="3.2" />
            <calibration rising="0" falling="0" />
            <dynamics damping="0" friction="0" />
            <safety_controller soft_lower_limit="-4.6251" soft_upper_limit="1.4835" k_position="15"
                k_velocity="10" />
        </joint>

        <xacro:link_with_inertial name="${arm_id}_link_5" xyz="-4.5588E-07 0.0038617 0.098257"
            rpy="0 0 0"
            mass="1.5812"
            ixx="0.0020612" ixy="8.7064E-09" ixz="-3.4742E-08" iyy="0.0014477" iyz="-2.8534E-05"
            izz="0.0019573"
            visual_mesh="package://fr5_description/meshes/visual/link_5.DAE"
            collision_mesh="package://fr5_description/meshes/collision/link_5.STL" />

        <joint name="${arm_id}_joint_5" type="revolute">
            <origin xyz="0 0 0.1021" rpy="1.5708 0 0" />
            <parent link="${arm_id}_link_4" />
            <child link="${arm_id}_link_5" />
            <axis xyz="0 0 1" />
            <limit lower="-3.0543" upper="3.0543" effort="28" velocity="3.2" />
            <calibration rising="0" falling="0" />
            <dynamics damping="0" friction="0" />
            <safety_controller soft_lower_limit="-3.0543" soft_upper_limit="3.0543" k_position="15"
                k_velocity="10" />
        </joint>

        <xacro:link_with_inertial name="${arm_id}_link_6" xyz="7.7496E-05 1.7751E-05 0.076122"
            rpy="0 0 0"
            mass="0.52542"
            ixx="0.00027721" ixy="-1.8677E-09" ixz="-1.188E-07" iyy="0.00027839" iyz="2.2607E-07"
            izz="0.00041605"
            visual_mesh="package://fr5_description/meshes/visual/link_6.DAE"
            collision_mesh="package://fr5_description/meshes/collision/link_6.STL" />

        <joint name="${arm_id}_joint_6" type="revolute">
            <origin xyz="0 0 0.102" rpy="-1.5708 0 0" />
            <parent link="${arm_id}_link_5" />
            <child link="${arm_id}_link_6" />
            <axis xyz="0 0 1" />
            <limit lower="-3.0543" upper="3.0543" effort="28" velocity="3.2" />
            <calibration rising="0" falling="0" />
            <dynamics damping="0" friction="0" />
            <safety_controller soft_lower_limit="-3.0543" soft_upper_limit="3.0543" k_position="15"
                k_velocity="10" />
        </joint>

        <!-- Tool Loading -->
        <xacro:include filename="$(find zlab_tools_description)/urdf/zlab_tools.xacro" />
        
        <!-- Always create ee_link as a reference point at the end of link_6 -->
        <link name="${arm_id}_ee_link" />
        <joint name="${arm_id}_ee_joint" type="fixed">
            <parent link="${arm_id}_link_6" />
            <child link="${arm_id}_ee_link" />
            <origin xyz="0 0 0.1" rpy="0 0 0" />
        </joint>

        <xacro:unless value="${tool_name == 'none'}">
            <xacro:load_tool 
                tool_name="${tool_name}" 
                prefix="${arm_id}" 
                parent="${arm_id}_ee_link" />
        </xacro:unless>

    </xacro:macro>

    <xacro:macro name="gazebo-joint" params="joint ">
        <transmission name="trans_${joint}">
            <type>transmission_interface/SimpleTransmission</type>
            <joint name="${joint}">
                <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
            </joint>
            <actuator name="${joint}_motor">
                <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
                <mechanicalReduction>1</mechanicalReduction>
            </actuator>
        </transmission>
    </xacro:macro>

</robot>