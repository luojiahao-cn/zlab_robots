<?xml version="1.0"?>
<launch>
  <!-- 环境配置文件 -->
  <arg name="environment_config"
       default="$(find zlab_environment)/config/arm1_environment.yaml"
       doc="Path to environment configuration YAML file"/>

  <!-- 是否加载环境 -->
  <arg name="load_environment" default="true" doc="Whether to load environment obstacles"/>

  <!-- 获取 arm_id 参数（如果存在） -->
  <arg name="arm_id" default="arm1" doc="Arm ID for frame_id replacement"/>

  <!-- 节点名称参数 -->
  <arg name="node_name" default="environment_loader" doc="Name of the node"/>

  <!-- 环境加载节点 -->
  <node if="$(arg load_environment)"
        name="$(arg node_name)"
        pkg="zlab_environment"
        type="environment_loader"
        output="screen">
    <param name="environment_config" value="$(arg environment_config)"/>
    <param name="arm_id" value="$(arg arm_id)"/>
  </node>
</launch>
