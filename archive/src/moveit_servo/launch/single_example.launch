<launch>

    <arg name="config" default="$(find moveit_servo)/config/single_config.yaml" />


    <node name="servo_server" pkg="moveit_servo" type="servo_server" output="screen">
        <rosparam command="load" file="$(arg config)" />
    </node>

    <!-- 停止当前控制器 -->
    <node pkg="rosservice" type="rosservice" name="stop_controller"
        args="call --wait /controller_manager/switch_controller '{start_controllers: [], stop_controllers: [fr5v6_arm_controller], strictness: 1}'"
        output="screen" />

    <!-- 加载新控制器 -->
    <node pkg="rosservice" type="rosservice" name="load_controller"
        args="call --wait /controller_manager/load_controller '{name: joints_position_controller}'"
        output="screen" />

    <!-- 启动新控制器 -->
    <node pkg="rosservice" type="rosservice" name="start_controller"
        args="call --wait /controller_manager/switch_controller '{start_controllers: [joints_position_controller], stop_controllers: [], strictness: 1}'"
        output="screen" />



</launch>