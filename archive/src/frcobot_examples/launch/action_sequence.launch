<launch>
  <!-- 
    动作序列节点启动文件
    该文件启动connect_single_arm.launch（已配置arm2和rviz=false），然后启动动作序列节点
  -->
  
  <!-- 启动单臂连接（arm2, IP: 192.168.31.203, rviz=false, tool=permanent_magnet） -->
  <include file="$(find frcobot_examples)/launch/connect_single_arm.launch">
    <arg name="arm" value="arm2" />
    <arg name="use_rviz" value="false" />
    <arg name="tool_name" value="permanent_magnet" />
  </include>
  
  <!-- 启动动作序列节点 -->
  <!-- 节点内部会等待MoveIt服务启动（代码中有2秒延迟） -->
  <node name="action_sequence_node" pkg="frcobot_examples" type="action_sequence_node"
        output="screen" respawn="false">
    <!-- 可以在这里添加ROS参数 -->
    <!-- 
      参数示例：
      <param name="initial_state_name" value="ready" />
      <param name="velocity_scaling_factor" value="0.5" />
    -->
  </node>
  
</launch>

