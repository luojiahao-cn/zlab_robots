<?xml version="1.0" encoding="utf-8"?>
<!--
    工具配置加载器
    从工具包加载配置
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!--
        加载工具配置
        参数:
        - tool_name: 工具名称
        返回: tool_config字典
    -->
    <xacro:macro name="load_tool_config" params="tool_name">
        <xacro:property name="tool_config_result" value="${None}"/>
        
        <!-- 从工具包加载 -->
        <xacro:property name="tool_package_config_path" 
                        value="$(find frcobot_tools)/tools/${tool_name}/config/tool.yaml"/>
        
        <xacro:try>
            <xacro:property name="tool_package_config" 
                            value="${xacro.load_yaml(tool_package_config_path)}"/>
            <xacro:property name="tool_config_result" value="${tool_package_config}"/>
            <xacro:property name="config_source" value="package"/>
        </xacro:try>
        <xacro:catch>
            <!-- 如果工具包不存在，返回空配置 -->
            <xacro:property name="tool_config_result" value="{
                'tool_type': 'simple',
                'origin': {'xyz': [0,0,0], 'rpy': [0,0,0]},
                'tcp': {'xyz': [0,0,0], 'rpy': [0,0,0]},
                'physical_properties': {'mass': 0.1, 'inertia': {'ixx': 0.1, 'ixy': 0.0, 'ixz': 0.0, 'iyy': 0.1, 'iyz': 0.0, 'izz': 0.1}}
            }"/>
        </xacro:catch>
        
        <!-- 如果工具名称为none，返回空配置 -->
        <xacro:if value="${tool_name == 'none'}">
            <xacro:property name="tool_config_result" value="{
                'tool_type': 'simple',
                'origin': {'xyz': [0,0,0], 'rpy': [0,0,0]},
                'tcp': {'xyz': [0,0,0], 'rpy': [0,0,0]},
                'physical_properties': {'mass': 0.1, 'inertia': {'ixx': 0.1, 'ixy': 0.0, 'ixz': 0.0, 'iyy': 0.1, 'iyz': 0.0, 'izz': 0.1}}
            }"/>
        </xacro:if>
        
    </xacro:macro>

</robot>

