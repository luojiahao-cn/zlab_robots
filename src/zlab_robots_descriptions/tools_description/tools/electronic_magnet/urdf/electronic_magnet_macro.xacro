<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Macro for Links and Internal Joints -->
  <xacro:macro name="electronic_magnet_links" params="prefix">
    <link name="${prefix}_electronic_magnet_base_link">
      <inertial>
        <origin xyz="-8.3267E-17 0.00012355 0.0077014" rpy="0 0 0" />
        <mass value="0.12279" />
        <inertia ixx="2.413E-05" ixy="-5.9292E-21" ixz="6.5341E-20" iyy="2.4481E-05" iyz="-7.2797E-08" izz="3.9841E-05" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://tools_description/tools/electronic_magnet/meshes/visual/electronic_magnet_base_link.STL" />
        </geometry>
        <material name="">
          <color rgba="1 0.94902 0.89804 1" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://tools_description/tools/electronic_magnet/meshes/collision/electronic_magnet_base_link.STL" />
        </geometry>
      </collision>
    </link>

    <link name="${prefix}_electronic_magnet_tcp_link">
      <inertial>
        <origin xyz="2.7756E-17 2.7756E-17 9.5087E-05" rpy="0 0 0" />
        <mass value="4.7133" />
        <inertia ixx="0.024838" ixy="0" ixz="-1.1723E-18" iyy="0.024838" iyz="2.1387E-19" izz="0.0017594" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://tools_description/tools/electronic_magnet/meshes/visual/electronic_magnet_tcp_link.STL" />
        </geometry>
        <material name="">
          <color rgba="0.53725 0.34902 0.33725 1" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://tools_description/tools/electronic_magnet/meshes/collision/electronic_magnet_tcp_link.STL" />
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}_electronic_magnet_tcp_joint" type="fixed">
      <origin xyz="0 0.00023753 0.145" rpy="0 0 0" />
      <parent link="${prefix}_electronic_magnet_base_link" />
      <child link="${prefix}_electronic_magnet_tcp_link" />
    </joint>

    <link name="${prefix}_electronic_magnet_ee_link">
    </link>

    <joint name="${prefix}_electronic_magnet_ee_joint" type="fixed">
      <origin xyz="0 0 0.125" rpy="0 0 0" />
      <parent link="${prefix}_electronic_magnet_tcp_link" />
      <child link="${prefix}_electronic_magnet_ee_link" />
    </joint>
  </xacro:macro>

  <!-- Macro for Full Tool (includes joint to parent) -->
  <xacro:macro name="electronic_magnet" params="prefix parent">
    <joint name="${prefix}_tool_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${prefix}_electronic_magnet_base_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <xacro:electronic_magnet_links prefix="${prefix}" />
  </xacro:macro>
</robot>