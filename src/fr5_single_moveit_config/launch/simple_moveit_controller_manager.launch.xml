<launch>
  <!-- Arm ID parameter -->
  <arg name="arm_id" default="arm1" doc="Arm ID to use"/>
  
  <!-- Define the MoveIt controller manager plugin to use for trajectory execution -->
  <param name="moveit_controller_manager" value="moveit_simple_controller_manager/MoveItSimpleControllerManager" />

  <!-- Load controller list from YAML file with parameter substitution -->
  <rosparam command="load" file="$(find fr5_single_moveit_config)/config/simple_moveit_controllers.yaml" subst_value="true"/>
  
  <!-- Load ROS controller configuration from YAML with parameter substitution -->
  <rosparam command="load" file="$(find fr5_single_moveit_config)/config/ros_controllers.yaml" subst_value="true"/>
</launch>
