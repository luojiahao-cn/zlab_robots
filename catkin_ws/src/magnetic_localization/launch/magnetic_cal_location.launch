<?xml version="1.0"?>
<launch>
    <!-- 加载传感器配置文件 -->
    <arg name="sensor_config" default="$(find magnetic_localization)/config/sensor_definitions.yaml" />

    <!-- 设置参数 -->
    <arg name="publish_rate" default="50" />  <!-- 发布频率(Hz) -->
    <arg name="filter_window" default="5" />  <!-- 滤波窗口大小 -->

    <!-- 启动磁场求解器节点 -->
    <node pkg="magnetic_localization" type="magnetic_solver_node" name="magnetic_solver"
        output="screen">
        <!-- 加载参数 -->
        <param name="sensor_definition_file" value="$(arg sensor_config)" />
        <param name="publish_rate" value="$(arg publish_rate)" />
        <param name="filter_window" value="$(arg filter_window)" />

        <!-- 重映射话题 -->
        <!-- <remap from="/magnetic/sensor_data" to="/magnetic_data" /> -->
        <!-- <remap from="/magnetic_estimation" to="/magnet/pose" /> -->
    </node>

    <!-- 可选：启动可视化工具 -->
    <!-- <node pkg="rviz" type="rviz" name="rviz"/> -->

    <!-- 可选：启动数据记录 -->
    <arg name="record" default="false" />
    <node pkg="rosbag" type="record" name="rosbag_record" output="screen"
        args="-o $(find magnetic_localization)/data/magnetic_data
                /sensor/magnetic_raw 
                /magnet/pose"
        if="$(arg record)" />
</launch>