<launch>
    <!-- 定义工具参数 -->
    <arg name="arm1_tool" default="none" doc="Tool name for arm1 (e.g., permanent_magnet, electronic_magnet, "/>
    <arg name="arm2_tool" default="none" doc="Tool name for arm2 (e.g., permanent_magnet, electronic_magnet, "/>
    
    <!-- 定义机械臂位置参数 -->
    <!-- arm1 位置 (x y z)，默认在原点 -->
    <arg name="arm1_xyz" default="0 0 0" doc="Position of arm1 base (x y z), default is origin"/>
    <!-- arm1 姿态 (roll pitch yaw) -->
    <arg name="arm1_rpy" default="0 0 0" doc="Orientation of arm1 base (roll pitch yaw)"/>
    <!-- arm2 位置 (x y z)，如果未指定，将从标定文件加载或使用默认值(1米右边) -->
    <arg name="arm2_xyz" default="" doc="Position of arm2 base (x y z). If empty, will load from calibration file or use default (1m to the right)"/>
    <!-- arm2 姿态 (roll pitch yaw)，如果未指定，将从标定文件加载或使用默认值 -->
    <arg name="arm2_rpy" default="" doc="Orientation of arm2 base (roll pitch yaw). If empty, will load from calibration file or use default"/>
    
    <!-- 加载机器人描述 -->
    <!-- xacro文件会自动处理标定文件加载 -->
    <param name="robot_description"
        command="$(find xacro)/xacro $(find fr5_description)/urdf/zlab_dual_arms.xacro
                arm1_tool:=$(arg arm1_tool)
                arm2_tool:=$(arg arm2_tool)
                arm1_xyz:='$(arg arm1_xyz)'
                arm1_rpy:='$(arg arm1_rpy)'
                arm2_xyz:='$(arg arm2_xyz)'
                arm2_rpy:='$(arg arm2_rpy)'"/>
    
    <!-- 定义use_gui参数，默认为true -->
    <arg name="use_gui" default="true" />

    <!-- 根据use_gui参数的值启动不同的joint_state_publisher -->
    <group if="$(arg use_gui)">
        <node name="joint_state_publisher_gui" pkg="joint_state_publisher_gui"
            type="joint_state_publisher_gui" />
    </group>
    <group unless="$(arg use_gui)">
        <node name="joint_state_publisher" pkg="joint_state_publisher" type="joint_state_publisher" />
    </group>

    <!-- Combine joint values -->
    <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" />

    <!-- Show in Rviz -->
    <node name="rviz" pkg="rviz" type="rviz"
        args="-d $(find fr5_description)/config/display_rviz.rviz" required="true" />

</launch>
