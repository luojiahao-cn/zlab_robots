<?xml version="1.0"?>
<launch>
  <!-- Robot IP addresses -->
  <arg name="diana7_ip" default="192.168.31.200" doc="IP address of diana7"/>
  <arg name="arm1_ip" default="192.168.31.201" doc="IP address of arm1"/>
  <arg name="arm2_ip" default="192.168.31.202" doc="IP address of arm2"/>
  
  <!-- Control loop frequency -->
  <arg name="loop_hz" default="60.0" doc="Control loop frequency (Hz)"/>
  
  <!-- Tool parameters -->
  <arg name="diana7_tool" default="none" doc="Tool name for diana7"/>
  <arg name="arm1_tool" default="none" doc="Tool name for arm1"/>
  <arg name="arm2_tool" default="none" doc="Tool name for arm2"/>
  
  <!-- MoveIt options -->
  <arg name="pipeline" default="ompl" doc="Planning pipeline to use with MoveIt"/>
  <arg name="use_rviz" default="true" doc="Start RViz"/>
  
  <!-- Arm position parameters (optional)107 -->
  <arg name="diana7_xyz" default="0 0 0" doc="Position of diana7 (x y z)"/>
  <arg name="diana7_rpy" default="0 0 0" doc="Orientation of diana7 (roll pitch yaw)"/>
  <arg name="arm1_xyz" default="1.42368 0.421054 0.071386" doc="Position of arm1 (x y z), empty for default"/>
  <arg name="arm1_rpy" default="0.0377814 0.0623607 -2.39063" doc="Orientation of arm1 (roll pitch yaw), empty for default"/>
  <arg name="arm2_xyz" default="1.30315 -0.727054 0.0589083" doc="Position of arm2 (x y z), empty for default"/>
  <arg name="arm2_rpy" default="0.0674776 -0.00760393 2.77198" doc="Orientation of arm2 (roll pitch yaw), empty for default"/>

  <!-- <arg name="diana7_xyz" default="0 0 0" doc="Position of diana7 (x y z)"/>
  <arg name="diana7_rpy" default="0 0 0" doc="Orientation of diana7 (roll pitch yaw)"/>
  <arg name="arm1_xyz" default="1.4 0.6 0" doc="Position of arm1 (x y z), empty for default"/>
  <arg name="arm1_rpy" default="0 0 3.14" doc="Orientation of arm1 (roll pitch yaw), empty for default"/>
  <arg name="arm2_xyz" default="1.4 -0.4 0" doc="Position of arm2 (x y z), empty for default"/>
  <arg name="arm2_rpy" default="0 0 3.14" doc="Orientation of arm2 (roll pitch yaw), empty for default"/> -->

  <!-- Load URDF -->
  <arg name="load_robot_description" default="true"/>
  <!-- <param if="$(arg load_robot_description)" name="robot_description"
         command="$(find xacro)/xacro '$(find fr5_description)/fr5_description/urdf/zlab_triple_arms.xacro'
                 diana7_tool:=$(arg diana7_tool) arm1_tool:=$(arg arm1_tool) arm2_tool:=$(arg arm2_tool)"/> -->
  <param if="$(arg load_robot_description)" name="robot_description"
         command="$(find xacro)/xacro '$(find fr5_description)/fr5_description/urdf/zlab_triple_arms.xacro'
                 diana7_xyz:='$(arg diana7_xyz)' diana7_rpy:='$(arg diana7_rpy)'
                 arm1_xyz:='$(arg arm1_xyz)' arm1_rpy:='$(arg arm1_rpy)'
                 arm2_xyz:='$(arg arm2_xyz)' arm2_rpy:='$(arg arm2_rpy)'
                 arm1_tool:='$(arg arm1_tool)'
                 arm2_tool:='$(arg arm2_tool)'
                 diana7_tool:='$(arg diana7_tool)'"/>

  <!-- Diana7 hardware interface -->
  <include file="$(find diana7_hardware)/launch/diana7_hardware.launch">
    <arg name="robot_ip" value="$(arg diana7_ip)"/>
    <arg name="tool_name" value="$(arg diana7_tool)"/>
    <arg name="load_robot_description" value="false"/>
    <arg name="publish_robot_state" value="false"/>
    <arg name="prefix" value="diana7_"/>
  </include>

  <!-- Arm1 hardware interface -->
  <include file="$(find fr5_hardware)/launch/fr5_hardware.launch">
    <arg name="arm_id" value="arm1"/>
    <arg name="robot_ip" value="$(arg arm1_ip)"/>
    <arg name="loop_hz" value="$(arg loop_hz)"/>
    <arg name="tool_name" value="$(arg arm1_tool)"/>
    <arg name="load_robot_description" value="false"/>
    <arg name="publish_robot_state" value="false"/>
    <arg name="spawn_joint_state_controller" value="true"/>
  </include>

  <!-- Arm2 hardware interface -->
  <include file="$(find fr5_hardware)/launch/fr5_hardware.launch">
    <arg name="arm_id" value="arm2"/>
    <arg name="robot_ip" value="$(arg arm2_ip)"/>
    <arg name="loop_hz" value="$(arg loop_hz)"/>
    <arg name="tool_name" value="$(arg arm2_tool)"/>
    <arg name="load_robot_description" value="false"/>
    <arg name="publish_robot_state" value="false"/>
    <arg name="spawn_joint_state_controller" value="true"/>
  </include>

  <!-- Robot state publisher (combines all three arms) -->
  <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher"/>

  <!-- Joint state publisher to merge joint_states from all namespaces -->
  <node name="joint_state_publisher" pkg="joint_state_publisher" type="joint_state_publisher">
    <rosparam param="source_list">[/diana7/joint_states, /arm1/joint_states, /arm2/joint_states]</rosparam>
  </node>
  
  <!-- Launch MoveIt -->
  <include file="$(find triple_arm_moveit_config)/launch/demo.launch">
    <arg name="diana7_tool" value="$(arg diana7_tool)"/>
    <arg name="arm1_tool" value="$(arg arm1_tool)"/>
    <arg name="arm2_tool" value="$(arg arm2_tool)"/>
    <arg name="diana7_xyz" value="$(arg diana7_xyz)"/>
    <arg name="diana7_rpy" value="$(arg diana7_rpy)"/>
    <arg name="arm1_xyz" value="$(arg arm1_xyz)"/>
    <arg name="arm1_rpy" value="$(arg arm1_rpy)"/>
    <arg name="arm2_xyz" value="$(arg arm2_xyz)"/>
    <arg name="arm2_rpy" value="$(arg arm2_rpy)"/>
    <arg name="moveit_controller_manager" value="simple"/>
    <arg name="load_robot_description" value="false"/>
    <arg name="pipeline" value="$(arg pipeline)"/>
    <arg name="use_rviz" value="$(arg use_rviz)"/>
  </include>
  
  
  
</launch>

