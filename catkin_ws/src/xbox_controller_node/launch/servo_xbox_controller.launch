<launch>
    <!-- 参数定义 -->
    <arg name="dev" default="/dev/input/js0" />
    <arg name="config_file" default="$(find xbox_controller_node)/config/xbox360_controller.yaml" />
    <arg name="linear_scale" default="0.2" />
    <arg name="angular_scale" default="0.2" />
    <arg name="joint_scale" default="0.1" />
    <arg name="deadzone" default="0.1" />
    <arg name="debug" default="false" />
    <arg name="is_xbox360_mode" default="true" />



    <!-- 启动joy节点 -->
    <node pkg="joy" type="joy_node" name="joy">
        <param name="dev" value="$(arg dev)" />
        <param name="deadzone" value="0.2" />
        <param name="autorepeat_rate" value="40" />
        <param name="coalesce_interval" value="0.025" />
    </node>

    <!-- 启动Xbox控制节点 -->
    <node pkg="xbox_controller_node" type="servo_xbox_input" name="servo_xbox_input" output="screen">
        <!-- 加载Xbox控制器配置 -->
        <rosparam command="load" file="$(arg config_file)" />

        <!-- 模式设置 -->
        <param name="is_xbox360_mode" value="$(arg is_xbox360_mode)" />

        <!-- 调试设置 -->
        <param if="$(arg debug)" name="debug" value="true" />

        <!-- 设置环境变量以启用调试日志 -->
        <env if="$(arg debug)" name="ROSCONSOLE_STDOUT_LINE_BUFFERED" value="1" />
        <env if="$(arg debug)" name="ROSCONSOLE_DEFAULT_VERBOSITY" value="debug" />
    </node>
</launch>