{
    "configurations": [
        {
            "browse": {
                "databaseFilename": "${default}",
                "limitSymbolsToIncludedHeaders": false
            },
            "includePath": [
                "/usr/include/**",
                "/opt/ros/noetic/include/**",
                "/opt/ros/noetic/share/**",
                "/opt/ros/noetic/lib/**",
                "${workspaceFolder}/catkin_ws/devel/include/**",
                "${workspaceFolder}/catkin_ws/src/frcobot_status/include/**",
                "${workspaceFolder}/catkin_ws/src/ros_control_boilerplate/frrobot_control/include/**",
                "${workspaceFolder}/catkin_ws/src/ros_control_boilerplate/include/**",
                "${workspaceFolder}/catkin_ws/src/moveit_servo/include/**"
            ],
            "name": "ROS",
            "intelliSenseMode": "gcc-x64",
            "compilerPath": "/usr/bin/gcc",
            "cStandard": "gnu11",
            "cppStandard": "c++14"
        }
    ],
    "version": 4
}